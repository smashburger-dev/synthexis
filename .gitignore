# Private material: gated hackathon pages, credentials, notes
private/
.env
.env.*

# Recordings and datasets contain faces and hands: never commit them
data/
recordings/
*.mov
*.mp4

# Model artifacts stay out of git, except the three shipped perception
# students (9 MB, no training data inside), so a clone runs the plugin
*.mlpackage/
!plugin/models/*.mlpackage/
# macOS matches data/ above case-blind against the package folder Data/
!plugin/models/*.mlpackage/Data/
*.mlmodelc/
*.onnx
*.pt
*.pth
*.safetensors

# Build output
probes/coreml-student-latency/bench
probes/coreml-student-latency/mem
probes/coreml-student-latency/models/
probes/apple-vision-fps/vision_probe
probes/fl-camera-plugin/synthexis-probe-standalone.app/
probes/headphone-motion/HeadphoneMotion.app/
probes/heart-rate-ble/HeartRateBLE.app/
tools/recorder/*.app/
target/
build/
dist/
.venv/
__pycache__/
*.pyc
.DS_Store
graphify-out/
